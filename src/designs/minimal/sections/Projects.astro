---
import type { Project } from "@/types/cv";
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  projects: Project[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const t = useTranslations(locale);
---

{projects.length > 0 && (
  <section aria-labelledby="projects-heading" class="container">
    <h2 id="projects-heading">{t.projects}</h2>
    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card" aria-label={project.name}>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <ul class="tag-list" aria-label={t.technologiesUsed}>
            {project.technologies.map((tech) => (
              <li class="tag">{tech}</li>
            ))}
          </ul>
          <p class="project-links">
            {project.url && (
              <a class="link" href={project.url}>
                {t.visit}
              </a>
            )}
            {project.url && project.repository && " · "}
            {project.repository && (
              <a class="link" href={project.repository}>
                {t.source}
              </a>
            )}
          </p>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-4);
  }

  .project-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    background: var(--color-bg-subtle);
  }

  .project-card h3 {
    font-size: 1rem;
    margin: 0 0 var(--space-2);
  }

  .project-links {
    margin: var(--space-2) 0 0;
    font-size: 0.875rem;
  }
</style>
