---
import type { Profile } from "@/types/cv";
import { localeMeta, useTranslations, type Locale } from "@/i18n";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { renderSVG } from "uqr";
import { displayUrl, localePath, pdfPath, withBase } from "@/utils/url";

interface Props {
  profile: Profile;
  locale: Locale;
}

const { profile, locale } = Astro.props;
const t = useTranslations(locale);

// QR code for the printed/PDF version, pointing back to this language's online CV.
const onlineUrl = new URL(localePath(locale), Astro.site).toString();
const qrSvg = renderSVG(onlineUrl, {
  ecc: "M",
  border: 0,
  blackColor: "#1a1a1a",
  whiteColor: "#ffffff",
});

// Absolute URLs are used as-is; relative paths are served from public/ under the site base.
const avatarSrc = profile.avatarUrl
  ? /^https?:\/\//.test(profile.avatarUrl)
    ? profile.avatarUrl
    : withBase(profile.avatarUrl)
  : undefined;
---

<header class="hero container">
  <div class="hero-top">
    {avatarSrc ? (
      <img
        class="hero-avatar"
        src={avatarSrc}
        alt={t.avatarAlt(profile.fullName)}
        width="112"
        height="112"
        decoding="async"
      />
    ) : (
      <span />
    )}
    <div class="hero-lang">
      <LanguageSwitcher locale={locale} />
    </div>
    <figure class="hero-qr print-only-block">
      <a href={onlineUrl} aria-label={t.qrCaption}>
        <Fragment set:html={qrSvg} />
      </a>
      <figcaption>
        {t.qrCaption}
        <br />
        {displayUrl(onlineUrl)}
      </figcaption>
    </figure>
  </div>
  <h1>{profile.fullName}</h1>
  <p class="hero-headline">{profile.headline}</p>
  <p class="hero-summary">{profile.summary}</p>

  <ul class="hero-links" aria-label={t.contactLinks}>
    {profile.links.map((link) => (
      <li>
        <a class="link" href={link.url}>
          {link.label}
          <span class="print-only">: {displayUrl(link.url)}</span>
        </a>
      </li>
    ))}
  </ul>

  {profile.location && <p class="muted hero-location">{profile.location}</p>}

  <p class="hero-download no-print">
    <a
      class="download-button"
      href={pdfPath(locale)}
      download={t.pdfFileName(profile.fullName)}
      hreflang={localeMeta[locale].htmlLang}
      type="application/pdf"
    >
      <svg
        aria-hidden="true"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10"></path>
      </svg>
      {t.downloadCv}
    </a>
  </p>
</header>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .hero-avatar {
    display: block;
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  /* Segmented control: same frame on every page, only the filled half moves. */
  .hero-lang :global(.lang-switch-list) {
    display: flex;
    margin: 0;
    padding: 2px;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 2px);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .hero-lang :global(.lang-switch-link) {
    display: block;
    min-width: 2.5rem;
    padding: 0.25rem 0.5rem;
    text-align: center;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .hero-lang :global(.lang-switch-link:hover) {
    color: var(--color-text);
    background: var(--color-bg-subtle);
  }

  .hero-lang :global(.lang-switch-link[aria-current="page"]) {
    color: var(--color-accent-contrast);
    background: var(--color-accent);
  }

  .hero-headline {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .hero-summary {
    max-width: 38rem;
    margin-top: var(--space-3);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .hero-location {
    margin-top: var(--space-3);
    font-size: 0.875rem;
  }

  .hero-download {
    margin-top: var(--space-4);
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
  }

  .download-button:hover {
    color: var(--color-accent-contrast);
    background: var(--color-accent);
  }

  .hero-qr {
    margin: 0;
    width: 7.5rem;
    text-align: center;
  }

  .hero-qr a {
    display: block;
    width: 5rem;
    margin-inline: auto;
  }

  .hero-qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-qr figcaption {
    margin-top: var(--space-1);
    font-size: 0.625rem;
    line-height: 1.3;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  @media print {
    .hero-top {
      margin-bottom: var(--space-3);
    }

    .hero-avatar {
      width: 5rem;
      height: 5rem;
    }

    .hero-links {
      gap: var(--space-1) var(--space-3);
      font-size: 0.875rem;
    }
  }
</style>
